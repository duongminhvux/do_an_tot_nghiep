# Runs inside the stock Nginx image's http block.
resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 3s;
server_tokens off;
map $http_upgrade $edge_connection_upgrade { default upgrade; '' close; }
# Only accept a single normalized protocol value from the trusted tunnel.
map $http_x_forwarded_proto $edge_forwarded_proto {
  default $scheme;
  http http;
  https https;
}
client_max_body_size 110m;
proxy_connect_timeout 8s;
proxy_read_timeout 300s;
proxy_send_timeout 300s;
proxy_http_version 1.1;
proxy_buffering off;

server {
  listen 8080 default_server;
  server_name _;
  location = /edge/health { default_type application/json; return 200 '{"status":"ok","edge":"nginx"}'; }
  location / { return 404; }
}
server {
  listen 8080;
  server_name ${WEB_HOSTS};
  include /etc/nginx/snippets/public-api.conf;
  location / {
    include /etc/nginx/snippets/proxy-headers.conf;
    set $edge_target web:3000;
    proxy_pass http://$edge_target$request_uri;
  }
}
server {
  listen 8080;
  server_name ${ADMIN_HOSTS};
  include /etc/nginx/snippets/public-api.conf;
  location / {
    include /etc/nginx/snippets/proxy-headers.conf;
    set $edge_target admin-web:3001;
    proxy_pass http://$edge_target$request_uri;
  }
}
server {
  listen 8080;
  server_name ${API_HOSTS};
  include /etc/nginx/snippets/public-api.conf;
  location / { return 404; }
}
