/// Prisma ORM mapping for the SQL-first ListenUp database.
/// Database structure source of truth: sql/database.sql
/// Development seed source: sql/seed.sql
/// Do not create Prisma migrations or use prisma db push for this project.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  INVITED

  @@map("user_status")
}

enum AuthClientType {
  USER_WEB
  ADMIN_WEB

  @@map("auth_client_type")
}

enum EnglishLevel {
  BEGINNER
  ELEMENTARY
  PRE_INTERMEDIATE
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED

  @@map("english_level")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

enum CourseVisibility {
  PUBLIC
  UNLISTED
  PRIVATE

  @@map("course_visibility")
}

enum AssignmentStatus {
  ACTIVE
  ENDED

  @@map("assignment_status")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED

  @@map("enrollment_status")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("progress_status")
}

enum ExerciseType {
  DICTATION
  TOEIC

  @@map("exercise_type")
}

enum DictationMode {
  SENTENCE
  PARAGRAPH

  @@map("dictation_mode")
}

enum ToeicPart {
  PART_1
  PART_2
  PART_3
  PART_4

  @@map("toeic_part")
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED

  @@map("difficulty")
}

enum QuestionKind {
  TEXT_INPUT
  MULTIPLE_CHOICE

  @@map("question_kind")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  ABANDONED
  EXPIRED

  @@map("attempt_status")
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT

  @@map("media_type")
}

enum MediaStorageProvider {
  LOCAL
  S3
  R2
  OTHER

  @@map("media_storage_provider")
}

enum MediaStatus {
  ACTIVE
  ARCHIVED

  @@map("media_status")
}

enum LessonResourceType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LINK

  @@map("lesson_resource_type")
}

enum AudioSource {
  UPLOAD
  TTS

  @@map("audio_source")
}

enum AudioSegmentType {
  INTRO
  NARRATION
  SPEAKER
  QUESTION
  OPTION
  PAUSE

  @@map("audio_segment_type")
}

enum TtsJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED

  @@map("tts_job_status")
}

enum LandingSectionType {
  HERO
  FEATURED_COURSES
  FEATURES
  HOW_IT_WORKS
  TOEIC_PRACTICE
  DICTATION_DEMO
  STATISTICS
  TESTIMONIALS
  FAQ
  FOOTER

  @@map("landing_section_type")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique @db.VarChar(320)
  passwordHash    String     @map("password_hash") @db.Text
  fullName        String     @map("full_name") @db.VarChar(120)
  avatarMediaId   String?    @map("avatar_media_id") @db.Uuid
  role            UserRole
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastActiveAt    DateTime?  @map("last_active_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  avatarMedia         MediaFile?                @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  preference          UserPreference?
  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  createdCourses      Course[]                  @relation("CourseCreatedBy")
  teacherAssignments  CourseTeacherAssignment[] @relation("AssignedTeacher")
  assignmentsCreated  CourseTeacherAssignment[] @relation("AssignmentCreatedBy")
  courseEnrollments   CourseEnrollment[]        @relation("EnrolledStudent")
  enrollmentsCreated  CourseEnrollment[]        @relation("EnrollmentCreatedBy")
  createdLessons      Lesson[]                  @relation("LessonCreatedBy")
  createdExercises    ListeningExercise[]       @relation("ExerciseCreatedBy")
  uploadedMedia       MediaFile[]               @relation("MediaUploadedBy")
  listeningAttempts   ListeningAttempt[]
  requestedTtsJobs    TtsJob[]                  @relation("TtsRequestedBy")
  auditLogs           AuditLog[]                @relation("AuditActor")
  lessonProgresses    LessonProgress[]

  @@index([role, status])
  @@index([status, lastActiveAt])
  @@map("users")
}

model StudentProfile {
  userId            String        @id @map("user_id") @db.Uuid
  targetLevel       EnglishLevel? @map("target_level")
  learningGoal      String?       @map("learning_goal") @db.Text
  preferredLanguage String        @default("en") @map("preferred_language") @db.VarChar(10)
  timezone          String        @default("UTC") @db.VarChar(64)
  bio               String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("student_profiles")
}

model TeacherProfile {
  userId    String   @id @map("user_id") @db.Uuid
  bio       String?  @db.Text
  expertise String[] @default([])
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("teacher_profiles")
}

model UserPreference {
  userId               String    @id @map("user_id") @db.Uuid
  emailNotifications   Boolean   @default(true) @map("email_notifications")
  learningReminder     Boolean   @default(true) @map("learning_reminder")
  reminderTime         DateTime? @map("reminder_time") @db.Time(0)
  timezone             String    @default("UTC") @db.VarChar(64)
  defaultPlaybackSpeed Decimal   @default(1.0) @map("default_playback_speed") @db.Decimal(3, 2)
  reducedMotion        Boolean   @default(false) @map("reduced_motion")
  locale               String    @default("en") @db.VarChar(10)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("user_preferences")
}

model RefreshSession {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  clientType       AuthClientType @map("client_type")
  refreshTokenHash String         @unique @map("refresh_token_hash") @db.Text
  userAgent        String?        @map("user_agent") @db.Text
  ipAddress        String?        @map("ip_address") @db.Inet
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime?      @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, clientType, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Course {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String           @unique @db.VarChar(180)
  title            String           @db.VarChar(200)
  description      String           @db.Text
  level            EnglishLevel
  category         String           @db.VarChar(100)
  visibility       CourseVisibility @default(PUBLIC)
  status           ContentStatus    @default(DRAFT)
  thumbnailMediaId String?          @map("thumbnail_media_id") @db.Uuid
  accentColor      String?          @map("accent_color") @db.VarChar(16)
  orderIndex       Int              @default(0) @map("order_index")
  createdById      String?          @map("created_by") @db.Uuid
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz(3)
  archivedAt       DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  thumbnailMedia     MediaFile?                @relation("CourseThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy          User?                     @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teacherAssignments CourseTeacherAssignment[]
  enrollments        CourseEnrollment[]
  lessons            Lesson[]

  @@index([status, visibility, orderIndex])
  @@index([level, status])
  @@map("courses")
}

model CourseTeacherAssignment {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId     String           @map("course_id") @db.Uuid
  teacherId    String           @map("teacher_id") @db.Uuid
  status       AssignmentStatus @default(ACTIVE)
  assignedAt   DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedById String?          @map("assigned_by") @db.Uuid
  endedAt      DateTime?        @map("ended_at") @db.Timestamptz(3)
  notes        String?          @db.Text

  course     Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teacher    User   @relation("AssignedTeacher", fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy User?  @relation("AssignmentCreatedBy", fields: [assignedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([courseId, teacherId])
  @@index([teacherId, status])
  @@index([courseId, status])
  @@map("course_teacher_assignments")
}

model CourseEnrollment {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId        String           @map("course_id") @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  progressPercent Decimal          @default(0) @map("progress_percent") @db.Decimal(5, 2)
  status          EnrollmentStatus @default(ACTIVE)
  enrolledById    String?          @map("enrolled_by") @db.Uuid
  enrolledAt      DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  lastAccessedAt  DateTime?        @map("last_accessed_at") @db.Timestamptz(3)
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  course     Course @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student    User   @relation("EnrolledStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrolledBy User?  @relation("EnrollmentCreatedBy", fields: [enrolledById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId, status, lastAccessedAt])
  @@index([courseId, status])
  @@map("course_enrollments")
}

model Lesson {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId                 String        @map("course_id") @db.Uuid
  slug                     String        @db.VarChar(180)
  title                    String        @db.VarChar(200)
  description              String        @db.Text
  content                  Json          @default("{\"blocks\":[]}")
  estimatedDurationMinutes Int           @default(0) @map("estimated_duration_minutes")
  orderIndex               Int           @map("order_index")
  status                   ContentStatus @default(DRAFT)
  coverMediaId             String?       @map("cover_media_id") @db.Uuid
  createdById              String?       @map("created_by") @db.Uuid
  publishedAt              DateTime?     @map("published_at") @db.Timestamptz(3)
  archivedAt               DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  coverMedia  MediaFile?          @relation("LessonCover", fields: [coverMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy   User?               @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  vocabulary  VocabularyItem[]
  expressions ExpressionItem[]
  resources   LessonResource[]
  progress    LessonProgress[]
  exercises   ListeningExercise[]

  @@unique([courseId, slug])
  @@unique([courseId, orderIndex])
  @@index([courseId, status, orderIndex])
  @@map("lessons")
}

model VocabularyItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  word       String   @db.VarChar(255)
  ipa        String?  @db.VarChar(255)
  meaning    String   @db.Text
  example    String?  @db.Text
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([lessonId, orderIndex])
  @@index([lessonId, word])
  @@map("vocabulary_items")
}

model ExpressionItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId   String   @map("lesson_id") @db.Uuid
  expression String   @db.Text
  meaning    String   @db.Text
  example    String?  @db.Text
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([lessonId, orderIndex])
  @@index([lessonId])
  @@map("expression_items")
}

model LessonResource {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId    String             @map("lesson_id") @db.Uuid
  type        LessonResourceType
  title       String             @db.VarChar(255)
  mediaId     String?            @map("media_id") @db.Uuid
  externalUrl String?            @map("external_url") @db.Text
  orderIndex  Int                @default(0) @map("order_index")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  media  MediaFile? @relation("LessonResourceMedia", fields: [mediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([lessonId, orderIndex])
  @@index([mediaId])
  @@map("lesson_resources")
}

model LessonProgress {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId        String         @map("lesson_id") @db.Uuid
  studentId       String         @map("student_id") @db.Uuid
  status          ProgressStatus @default(NOT_STARTED)
  progressPercent Decimal        @default(0) @map("progress_percent") @db.Decimal(5, 2)
  bestScore       Decimal?       @map("best_score") @db.Decimal(5, 2)
  startedAt       DateTime?      @map("started_at") @db.Timestamptz(3)
  lastOpenedAt    DateTime?      @map("last_opened_at") @db.Timestamptz(3)
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId, status, updatedAt])
  @@index([lessonId, status])
  @@map("lesson_progress")
}

model MediaFile {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey      String               @map("storage_key") @db.Text
  originalName    String               @map("original_name") @db.Text
  publicUrl       String?              @map("public_url") @db.Text
  mimeType        String               @map("mime_type") @db.VarChar(255)
  type            MediaType
  storageProvider MediaStorageProvider @default(LOCAL) @map("storage_provider")
  storageBucket   String?              @map("storage_bucket") @db.VarChar(255)
  sizeBytes       BigInt               @map("size_bytes")
  durationMs      Int?                 @map("duration_ms")
  width           Int?
  height          Int?
  checksumSha256  String?              @map("checksum_sha256") @db.Char(64)
  status          MediaStatus          @default(ACTIVE)
  metadata        Json                 @default("{}")
  uploadedById    String?              @map("uploaded_by") @db.Uuid
  archivedAt      DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploadedBy         User?                  @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  avatarForUsers     User[]                 @relation("UserAvatar")
  courseThumbnails   Course[]               @relation("CourseThumbnail")
  lessonCovers       Lesson[]               @relation("LessonCover")
  lessonResources    LessonResource[]       @relation("LessonResourceMedia")
  exerciseFinalAudio ListeningExercise[]    @relation("ExerciseFinalAudio")
  groupImages        ExerciseGroup[]        @relation("ExerciseGroupImage")
  groupSharedAudio   ExerciseGroup[]        @relation("ExerciseGroupAudio")
  questionImages     ExerciseQuestion[]     @relation("ExerciseQuestionImage")
  audioSegments      ExerciseAudioSegment[] @relation("AudioSegmentMedia")
  ttsOutputFor       TtsJob?                @relation("TtsOutput")
  siteLogoFor        SiteSetting[]          @relation("SiteLogo")
  siteFaviconFor     SiteSetting[]          @relation("SiteFavicon")

  @@unique([storageProvider, storageKey])
  @@index([type, status, createdAt])
  @@index([uploadedById, status])
  @@map("media_files")
}

model ListeningExercise {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId              String         @map("lesson_id") @db.Uuid
  slug                  String         @db.VarChar(180)
  type                  ExerciseType
  dictationMode         DictationMode? @map("dictation_mode")
  toeicPart             ToeicPart?     @map("toeic_part")
  title                 String         @db.VarChar(255)
  instruction           String         @db.Text
  difficulty            Difficulty     @default(INTERMEDIATE)
  sourceScript          String?        @map("source_script") @db.Text
  transcript            String?        @db.Text
  passThreshold         Decimal        @default(80) @map("pass_threshold") @db.Decimal(5, 2)
  maxPlays              Int            @default(3) @map("max_plays")
  maxAttempts           Int            @default(3) @map("max_attempts")
  ignoreCapitalization  Boolean        @default(true) @map("ignore_capitalization")
  ignorePunctuation     Boolean        @default(true) @map("ignore_punctuation")
  ignoreExtraSpaces     Boolean        @default(true) @map("ignore_extra_spaces")
  allowMinorTypo        Boolean        @default(false) @map("allow_minor_typo")
  showTranscript        Boolean        @default(false) @map("show_transcript")
  showAnswerAfterSubmit Boolean        @default(true) @map("show_answer_after_submit")
  audioSource           AudioSource    @default(UPLOAD) @map("audio_source")
  finalAudioMediaId     String?        @map("final_audio_media_id") @db.Uuid
  status                ContentStatus  @default(DRAFT)
  orderIndex            Int            @default(0) @map("order_index")
  createdById           String?        @map("created_by") @db.Uuid
  publishedAt           DateTime?      @map("published_at") @db.Timestamptz(3)
  archivedAt            DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson          Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  finalAudioMedia MediaFile?             @relation("ExerciseFinalAudio", fields: [finalAudioMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy       User?                  @relation("ExerciseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  groups          ExerciseGroup[]
  questions       ExerciseQuestion[]
  audioSegments   ExerciseAudioSegment[]
  attempts        ListeningAttempt[]
  ttsJobs         TtsJob[]

  @@unique([lessonId, slug])
  @@unique([lessonId, orderIndex])
  @@index([lessonId, type, toeicPart, status])
  @@index([status, updatedAt])
  @@map("listening_exercises")
}

model ExerciseGroup {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId         String   @map("exercise_id") @db.Uuid
  title              String?  @db.VarChar(255)
  label              String?  @db.VarChar(80)
  sharedScript       String?  @map("shared_script") @db.Text
  orderIndex         Int      @map("order_index")
  imageMediaId       String?  @map("image_media_id") @db.Uuid
  sharedAudioMediaId String?  @map("shared_audio_media_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  exercise      ListeningExercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  image         MediaFile?             @relation("ExerciseGroupImage", fields: [imageMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sharedAudio   MediaFile?             @relation("ExerciseGroupAudio", fields: [sharedAudioMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  questions     ExerciseQuestion[]
  audioSegments ExerciseAudioSegment[]
  listenEvents  AttemptListenEvent[]
  ttsJobs       TtsJob[]

  @@unique([exerciseId, orderIndex])
  @@index([exerciseId])
  @@map("exercise_groups")
}

model ExerciseQuestion {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId   String       @map("exercise_id") @db.Uuid
  groupId      String?      @map("group_id") @db.Uuid
  questionText String       @map("question_text") @db.Text
  kind         QuestionKind @map("question_kind")
  correctText  String?      @map("correct_text") @db.Text
  imageMediaId String?      @map("image_media_id") @db.Uuid
  orderIndex   Int          @map("order_index")
  explanation  String?      @db.Text
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  exercise       ListeningExercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  group          ExerciseGroup?         @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  image          MediaFile?             @relation("ExerciseQuestionImage", fields: [imageMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  options        ExerciseOption[]
  audioSegments  ExerciseAudioSegment[]
  attemptAnswers AttemptAnswer[]

  @@index([exerciseId, groupId, orderIndex])
  @@index([groupId, orderIndex])
  @@map("exercise_questions")
}

model ExerciseOption {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  label      String   @db.VarChar(4)
  content    String   @db.Text
  isCorrect  Boolean  @default(false) @map("is_correct")
  orderIndex Int      @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  question        ExerciseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  selectedAnswers AttemptAnswer[]  @relation("SelectedOption")

  @@unique([questionId, label])
  @@unique([questionId, orderIndex])
  @@index([questionId])
  @@map("exercise_options")
}

model ExerciseAudioSegment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId       String           @map("exercise_id") @db.Uuid
  groupId          String?          @map("group_id") @db.Uuid
  questionId       String?          @map("question_id") @db.Uuid
  segmentType      AudioSegmentType @map("segment_type")
  speakerKey       String?          @map("speaker_key") @db.VarChar(80)
  speakerLabel     String?          @map("speaker_label") @db.VarChar(120)
  text             String           @db.Text
  voiceId          String?          @map("voice_id") @db.VarChar(160)
  language         String           @default("en-US") @db.VarChar(20)
  speed            Decimal          @default(1.0) @db.Decimal(3, 2)
  pauseAfterMs     Int              @default(0) @map("pause_after_ms")
  orderIndex       Int              @map("order_index")
  mediaId          String?          @map("media_id") @db.Uuid
  generationStatus TtsJobStatus?    @map("generation_status")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  exercise ListeningExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  group    ExerciseGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  question ExerciseQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  media    MediaFile?        @relation("AudioSegmentMedia", fields: [mediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  ttsJobs  TtsJob[]

  @@unique([exerciseId, orderIndex])
  @@index([exerciseId, groupId, questionId])
  @@index([generationStatus])
  @@map("exercise_audio_segments")
}

model ListeningAttempt {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId      String        @map("exercise_id") @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  status          AttemptStatus @default(IN_PROGRESS)
  score           Decimal?      @db.Decimal(5, 2)
  passed          Boolean?
  attemptNumber   Int           @map("attempt_number")
  playCount       Int           @default(0) @map("play_count")
  startedAt       DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedAt     DateTime?     @map("submitted_at") @db.Timestamptz(3)
  gradedAt        DateTime?     @map("graded_at") @db.Timestamptz(3)
  durationSeconds Int?          @map("duration_seconds")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  exercise     ListeningExercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student      User                 @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  answers      AttemptAnswer[]
  listenEvents AttemptListenEvent[]

  @@unique([exerciseId, studentId, attemptNumber])
  @@index([studentId, status, submittedAt])
  @@index([exerciseId, status, submittedAt])
  @@map("listening_attempts")
}

model AttemptAnswer {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  selectedOptionId String?  @map("selected_option_id") @db.Uuid
  studentText      String?  @map("student_text") @db.Text
  correctText      String?  @map("correct_text") @db.Text
  isCorrect        Boolean? @map("is_correct")
  score            Decimal? @db.Decimal(5, 2)
  feedback         Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempt        ListeningAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  question       ExerciseQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  selectedOption ExerciseOption?  @relation("SelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("attempt_answers")
}

model AttemptListenEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId     String   @map("attempt_id") @db.Uuid
  groupId       String?  @map("group_id") @db.Uuid
  playNumber    Int      @map("play_number")
  playedAt      DateTime @default(now()) @map("played_at") @db.Timestamptz(3)
  playbackSpeed Decimal? @map("playback_speed") @db.Decimal(3, 2)

  attempt ListeningAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  group   ExerciseGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([attemptId, playNumber])
  @@index([attemptId, groupId])
  @@index([attemptId, playedAt])
  @@map("attempt_listen_events")
}

model TtsJob {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exerciseId     String?      @map("exercise_id") @db.Uuid
  audioSegmentId String?      @map("audio_segment_id") @db.Uuid
  groupId        String?      @map("group_id") @db.Uuid
  requestedById  String?      @map("requested_by") @db.Uuid
  provider       String       @db.VarChar(80)
  model          String?      @db.VarChar(120)
  language       String       @default("en-US") @db.VarChar(20)
  voiceId        String       @map("voice_id") @db.VarChar(160)
  speed          Decimal      @default(1.0) @db.Decimal(3, 2)
  inputText      String       @map("input_text") @db.Text
  normalizedText String       @map("normalized_text") @db.Text
  inputHash      String       @map("input_hash") @db.Char(64)
  status         TtsJobStatus @default(PENDING)
  progress       Int          @default(0)
  outputMediaId  String?      @unique @map("output_media_id") @db.Uuid
  errorCode      String?      @map("error_code") @db.VarChar(100)
  errorMessage   String?      @map("error_message") @db.Text
  retryCount     Int          @default(0) @map("retry_count")
  startedAt      DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  exercise     ListeningExercise?    @relation(fields: [exerciseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  audioSegment ExerciseAudioSegment? @relation(fields: [audioSegmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  group        ExerciseGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  requestedBy  User?                 @relation("TtsRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  outputMedia  MediaFile?            @relation("TtsOutput", fields: [outputMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([exerciseId, status])
  @@index([audioSegmentId, status])
  @@index([groupId, status])
  @@map("tts_jobs")
}

model TtsSetting {
  id              String   @id @default("default") @db.VarChar(50)
  enabled         Boolean  @default(false)
  provider        String   @db.VarChar(80)
  defaultLanguage String   @default("en-US") @map("default_language") @db.VarChar(20)
  defaultVoiceId  String   @map("default_voice_id") @db.VarChar(160)
  defaultSpeed    Decimal  @default(1.0) @map("default_speed") @db.Decimal(3, 2)
  providerConfig  Json     @default("{}") @map("provider_config")
  secretReference String?  @map("secret_reference") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("tts_settings")
}

model LandingSection {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        LandingSectionType
  title       String             @db.VarChar(200)
  enabled     Boolean            @default(true)
  orderIndex  Int                @map("order_index")
  config      Json               @default("{}")
  status      ContentStatus      @default(DRAFT)
  version     Int                @default(1)
  publishedAt DateTime?          @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([type, version])
  @@index([enabled, orderIndex])
  @@index([status, orderIndex])
  @@map("landing_sections")
}

model SiteSetting {
  id             String   @id @default("default") @db.VarChar(50)
  siteName       String   @map("site_name") @db.VarChar(120)
  logoMediaId    String?  @map("logo_media_id") @db.Uuid
  faviconMediaId String?  @map("favicon_media_id") @db.Uuid
  primaryColor   String   @default("#2563EB") @map("primary_color") @db.VarChar(16)
  contactEmail   String?  @map("contact_email") @db.VarChar(320)
  contactPhone   String?  @map("contact_phone") @db.VarChar(40)
  address        String?  @db.Text
  footerText     String?  @map("footer_text") @db.Text
  socialLinks    Json     @default("{}") @map("social_links")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  logo    MediaFile? @relation("SiteLogo", fields: [logoMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  favicon MediaFile? @relation("SiteFavicon", fields: [faviconMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("site_settings")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
