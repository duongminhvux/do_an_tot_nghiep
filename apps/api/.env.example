# =========================
# APP CONFIGURATION
# =========================
PORT=5000

# =========================
# DATABASE (MONGODB)
# =========================
MONGO_URI=mongodb://127.0.0.1:27017/english-platform

# =========================
# JWT AUTHENTICATION
# =========================
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_TOKEN_EXPIRES=7d

# =========================
# GOOGLE OAUTH 2.0
# =========================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
SESSION_SECRET=your_session_secret_key

# =========================
# FRONTEND CLIENT URL
# =========================
FRONTEND_URL=http://localhost:3000

# =========================
# EMAIL SERVICE (GMAIL SMTP)
# =========================
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=Daily English
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# =========================
# CLOUDINARY
# =========================
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# =========================
# ADMIN CLIENT URL
# =========================
ADMIN_URL=http://localhost:3001

# =========================
# LOCAL TTS SERVICE
# =========================
# Docker Compose overrides this to http://tts-service:8001.
TTS_SERVICE_URL=http://localhost:8001
TTS_REQUEST_TIMEOUT_MS=120000

# =========================
# DEFAULT ADMIN (LOCAL / INITIAL SEED)
# =========================
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
# Set true only when you explicitly want startup to overwrite the default
# admin credentials in an existing database. Keep false normally.
DEFAULT_ADMIN_SYNC_PASSWORD=false
