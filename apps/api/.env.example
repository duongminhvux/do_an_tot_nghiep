# PostgreSQL 16 development database. Do not commit a real .env file.
DATABASE_URL="postgresql://listenup:listenup_dev_only@localhost:5432/listenup?schema=public"
API_PORT=4000
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false
MEDIA_ROOT=./storage/media
MAX_UPLOAD_SIZE_MB=25
TTS_ENABLED=true
TTS_PROVIDER=kokoro
KOKORO_TTS_URL=http://localhost:8001
KOKORO_TTS_TIMEOUT_MS=180000
RESET_URL_BASE=http://localhost:3000/reset-password
ADMIN_RESET_URL_BASE=http://localhost:3001/reset-password
