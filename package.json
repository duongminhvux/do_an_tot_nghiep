{
  "name": "my-fullstack-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dev:local": "node scripts/dev-local.mjs all",
    "dev:gateway": "node scripts/dev-gateway.mjs",
    "dev:infra": "docker compose -f compose.infra.yml up -d --build",
    "dev:docker": "docker compose up -d --build",
    "audit:postgres": "python scripts/audit-postgres.py",
    "audit:postgres-native": "node scripts/audit-postgres-native.cjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.13",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
