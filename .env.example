# ============================================================
# SINGLE SOURCE OF ENVIRONMENT CONFIGURATION
# Copy this file to .env at the repository root.
# Do not create per-app .env files under apps/*.
# ============================================================

# =========================
# APP / PUBLIC URLS
# =========================
PORT=5000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:5000/api
DOCKER_NODE_ENV=production

# =========================
# DATABASE
# Local Node scripts / local NestJS use MONGO_URI.
# Docker API uses DOCKER_MONGO_URI.
# =========================
MONGO_DB_NAME=english-platform
MONGO_URI=mongodb://127.0.0.1:27017/english-platform
DOCKER_MONGO_URI=mongodb://mongo:27017/english-platform

# =========================
# JWT AUTHENTICATION
# =========================
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_TOKEN_EXPIRES=7d

# =========================
# GOOGLE OAUTH 2.0
# =========================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
SESSION_SECRET=replace_with_a_long_random_session_secret

# =========================
# EMAIL SERVICE
# =========================
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM="Daily English"
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# =========================
# CLOUDINARY
# =========================
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# =========================
# DEFAULT ADMIN
# =========================
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_SYNC_PASSWORD=false

# =========================
# KOKORO TTS
# Local API calls TTS_SERVICE_URL.
# Docker API calls DOCKER_TTS_SERVICE_URL.
# =========================
TTS_SERVICE_URL=http://localhost:8001
DOCKER_TTS_SERVICE_URL=http://tts-service:8001
TTS_REQUEST_TIMEOUT_MS=120000
KOKORO_DEVICE=cpu
KOKORO_DEVICE_GPU=cuda
KOKORO_MODEL_ID=hexgrad/Kokoro-82M
KOKORO_HF_HOME=/models/huggingface
TORCH_VERSION=2.7.1
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_INDEX_URL_GPU=https://download.pytorch.org/whl/cu126

# =========================
# FASTER WHISPER ASR
# Local API calls ASR_SERVICE_URL.
# Docker API calls DOCKER_ASR_SERVICE_URL.
# =========================
ASR_SERVICE_URL=http://localhost:8002
DOCKER_ASR_SERVICE_URL=http://asr-service:8002
ASR_REQUEST_TIMEOUT_MS=600000
ASR_DEVICE=cpu
ASR_DEVICE_GPU=cuda
ASR_COMPUTE_TYPE=int8
ASR_COMPUTE_TYPE_GPU=float16
ASR_MODEL=small.en
ASR_MODEL_DIR=/models/faster-whisper
ASR_VAD_FILTER=true
ASR_BEAM_SIZE=5
ASR_SENTENCE_GAP_MS=900
ASR_MAX_UPLOAD_MB=100

# =========================
# DICTATION AUDIO METADATA
# =========================
DICTATION_SEGMENT_START_PADDING_MS=100
DICTATION_SEGMENT_END_PADDING_MS=150
DICTATION_MAX_ATTEMPTS_BEFORE_REVEAL=3
DICTATION_AUTO_NEXT_DELAY_MS=700
