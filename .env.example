# ONE ROOT .env for both Docker Compose and native Node/Next development.
# Copy this file to .env, use unique secrets, and never commit .env.

# PostgreSQL (full Docker mode provisions one PostgreSQL server with eight databases)
PG_SUPERUSER=vocalearn_root
POSTGRES_PASSWORD=CHANGE_POSTGRES_SUPERUSER_PASSWORD_2026
PG_IDENTITY_PASSWORD=CHANGE_IDENTITY_PG_PASSWORD_2026
PG_CONTENT_PASSWORD=CHANGE_CONTENT_PG_PASSWORD_2026
PG_ASSESSMENT_PASSWORD=CHANGE_ASSESSMENT_PG_PASSWORD_2026
PG_ARENA_PASSWORD=CHANGE_ARENA_PG_PASSWORD_2026
PG_LEARNING_PASSWORD=CHANGE_LEARNING_PG_PASSWORD_2026
PG_MEDIA_PASSWORD=CHANGE_MEDIA_PG_PASSWORD_2026
PG_AI_IMPORT_PASSWORD=CHANGE_AI_IMPORT_PG_PASSWORD_2026
PG_NOTIFICATION_PASSWORD=CHANGE_NOTIFICATION_PG_PASSWORD_2026

# For local PostgreSQL, set these to the local installed PostgreSQL superuser.
PG_LOCAL_SUPERUSER=postgres
PG_LOCAL_PASSWORD=CHANGE_LOCAL_PG_SUPERUSER_PASSWORD

# Redis and RabbitMQ (Docker in BOTH modes)
RABBITMQ_USER=vocalearn
RABBITMQ_PASSWORD=CHANGE_RABBITMQ_PASSWORD_2026

# S3-compatible object storage (SeaweedFS)
S3_ACCESS_KEY=CHANGE_OBJECT_STORAGE_ACCESS_KEY
S3_SECRET_KEY=CHANGE_OBJECT_STORAGE_SECRET_2026
S3_BUCKET=vocalearn-media
MEDIA_STORAGE_BACKEND=s3
MEDIA_INTERNAL_TOKEN=CHANGE_MEDIA_INTERNAL_TOKEN_LONG_2026
JOB_INTERNAL_TOKEN=CHANGE_JOB_INTERNAL_TOKEN_LONG_2026
INTERNAL_SERVICE_TOKEN=CHANGE_GENERAL_INTERNAL_TOKEN_2026
IDENTITY_INTERNAL_TOKEN=CHANGE_IDENTITY_INTERNAL_TOKEN_2026

JWT_ACCESS_SECRET=CHANGE_ACCESS_JWT_RANDOM_MIN_32_CHARS_2026
JWT_REFRESH_SECRET=CHANGE_REFRESH_JWT_RANDOM_MIN_32_CHARS_2026
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_TOKEN_EXPIRES=7d

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:5000/api
MEDIA_PUBLIC_BASE_URL=http://localhost:5000/media
API_PUBLISHED_PORT=5000

ADMIN_SEED_ENABLED=true
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD_12_CHARS_MINIMUM
ADMIN_SEED_ALLOW_WEAK_PASSWORD=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=VocaLearn
MAIL_USERNAME=
MAIL_PASSWORD=

KOKORO_DEVICE=cpu
KOKORO_MODEL_ID=hexgrad/Kokoro-82M
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_MODEL=small
VOCAB_TTS_US_VOICE=af_heart
VOCAB_TTS_UK_VOICE=bf_emma
VOCAB_TTS_SPEED=1
TOEIC_TTS_SPEED=1
AUDIO_JOB_RETRIES=3
