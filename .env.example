POSTGRES_DB=listenup
POSTGRES_USER=listenup
POSTGRES_PASSWORD=listenup_dev_password
DATABASE_URL=postgresql://listenup:listenup_dev_password@localhost:5432/listenup?schema=public
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false
MEDIA_ROOT=./storage/media
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/api/v1/media
MAX_UPLOAD_SIZE_MB=25
TTS_ENABLED=true
TTS_PROVIDER=kokoro
KOKORO_TTS_URL=http://tts-service:8001
KOKORO_TTS_TIMEOUT_MS=180000
KOKORO_DEVICE=cuda
KOKORO_MODEL_ID=hexgrad/Kokoro-82M
RESET_URL_BASE=http://localhost:3000/reset-password
ADMIN_RESET_URL_BASE=http://localhost:3001/reset-password
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_USE_MOCK_API=false
